    "@bull-board/api": "^9.5.0",
    "@bull-board/express": "^9.5.0",
    "@elastic/elasticsearch": "^8.11.0",
    "@prisma/client": "^5.7.0",
    "@slack/web-api": "^6.10.0",
    "axios": "^1.6.2",
    "bullmq": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^9.4.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "papaparse": "^5.4.1"
